generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


model Admin {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  email    String    @unique
  password String
  clientes Cliente[]                       
}

model TokenBlacklist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model Cliente {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  nome     String
  email    String   @unique
  telefone Int 

  adminId  String   @db.ObjectId         
  admin    Admin    @relation(fields: [adminId], references: [id])

  carros   Carro[]                       
  @@index([adminId])                      
}

model TrocaOleo {
  id String  @id @default(auto()) @map("_id") @db.ObjectId
  oleoDataTroca         DateTime
  oleoDataProximaTroca  DateTime
  kmTroca Int
  KmProximaTroca Int
  tipoOleo String
  carroId String @db.ObjectId
  status Boolean
  carro Carro @relation(fields: [carroId], references: [id])

  @@index([carroId])

}


model Carro {
  id                    String      @id @default(auto()) @map("_id") @db.ObjectId
  placa                 String      @unique
  modelo                String
  clienteId             String      @db.ObjectId
  cliente               Cliente     @relation(fields: [clienteId], references: [id])
  
  trocasOleo            TrocaOleo[]

  @@index([clienteId])                 
}
